---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Atributo sizes: ancho real que ocupa la imagen según el viewport. */
  sizes: string;
  loading?: 'lazy' | 'eager';
  /** "high" para la imagen principal de la primera pantalla (mejora el LCP). */
  fetchpriority?: 'high' | 'low' | 'auto';
  style?: string;
}

const { src, alt, sizes, loading = 'lazy', fetchpriority, style } = Astro.props;
---

<Image
  src={src}
  alt={alt}
  format="webp"
  quality={80}
  widths={[400, 640, 800, 1200, 1600]}
  sizes={sizes}
  loading={loading}
  decoding="async"
  fetchpriority={fetchpriority}
  style={style}
/>

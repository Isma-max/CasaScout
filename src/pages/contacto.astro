---
import Base from '../layouts/Base.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { site, waUrl } from '../config/site';
---

<Base
  title="Contacto · Casa Scout"
  description="Cotiza tu proyecto por WhatsApp o con un formulario breve."
  pageClass="pg-contacto"
  current="contacto"
>
  <section class="top grid" aria-labelledby="c-h1">
    <h1 id="c-h1">Conversemos</h1>
    <p class="lead">No necesitas saber qué producto quieres. Cuéntanos qué buscas y te ayudamos a definirlo.</p>
  </section>

  <section class="two grid" aria-label="Dos formas de contactarnos">
    {
      waUrl && (
        <div class="wa rv">
          <h2 style="font-size:30px">Por WhatsApp</h2>
          <p>Para conversar una idea, resolver dudas rápidas o empezar un proyecto.</p>
          <WhatsAppButton label="Escribir por WhatsApp" />
          {(site.horario || site.email || site.ciudad) && (
            <dl>
              {site.horario && <><dt>Horario</dt><dd>{site.horario}</dd></>}
              {site.email && <><dt>Correo</dt><dd>{site.email}</dd></>}
              {site.ciudad && <><dt>Ciudad</dt><dd>{site.ciudad}</dd></>}
            </dl>
          )}
        </div>
      )
    }
    {
      site.email && (
        <form class="quote-form rv2" data-quote-form data-email={site.email} novalidate aria-labelledby="c-form">
          <h2 id="c-form">Solicitar cotización</h2>
          <p class="intro">Te respondemos con una propuesta.{site.plazoRespuesta && ` ${site.plazoRespuesta}`}</p>
          <div class="f"><label for="k-n">Nombre</label><input id="k-n" required type="text" autocomplete="name" name="nombre" /></div>
          <div class="f"><label for="k-e">Correo</label><input id="k-e" type="email" autocomplete="email" name="correo" /></div>
          <div class="f full"><label for="k-w">WhatsApp</label><input id="k-w" type="tel" autocomplete="tel" placeholder="+56 9" name="whatsapp" /></div>
          <div class="f full"><label for="k-q">¿Qué necesitas?</label><textarea id="k-q" placeholder="Por ejemplo: 150 kits de bienvenida para marzo, o una idea para el aniversario de la empresa." name="necesidad"></textarea></div>
          <div class="send"><button class="btn" type="submit">Enviar solicitud</button></div>
        </form>
      )
    }
  </section>
</Base>

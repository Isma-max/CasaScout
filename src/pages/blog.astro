---
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { articulosPublicados, categorias, minutosLectura, nombreCategoria, urlArticulo } from '../lib/blog';

const articulos = await articulosPublicados();
const destacado = articulos.find((a) => a.data.featured) ?? articulos[0];
// Solo se muestran los filtros de categorías que tienen artículos publicados.
const filtros = categorias.filter((c) => articulos.some((a) => a.data.category === c.id));
---

<Base
  title="Blog · Casa Scout"
  description="Guías para elegir regalos y merchandising que representen bien a tu organización."
  pageClass="pg-blog"
  current="blog"
>
  <section class="top grid" aria-labelledby="b-h1">
    <h1 id="b-h1">Blog</h1>
    <p class="lead">Guías para elegir regalos y merchandising que representen bien a tu organización.</p>
  </section>

  {
    destacado && (
      <section class="featured grid" aria-labelledby="b-feat">
        <figure class="ph rv">
          <Pic src={destacado.data.image} alt={destacado.data.imageAlt} sizes="(max-width: 820px) 100vw, 58vw" />
          <span class="tag">Render provisional</span>
        </figure>
        <div class="t rv2">
          <span class="k">{nombreCategoria(destacado.data.category)} · {minutosLectura(destacado)} min de lectura</span>
          <h2 id="b-feat"><a href={urlArticulo(destacado)}>{destacado.data.title}</a></h2>
          <p>{destacado.data.description}</p>
          <a class="link" href={urlArticulo(destacado)}><span>Leer el artículo</span> →</a>
        </div>
      </section>
    )
  }

  {
    articulos.length > 0 && (
      <section class="posts grid" aria-labelledby="b-all">
        <div class="h rv"><h2 id="b-all">Todos los artículos</h2>
          {articulos.length > 1 && (
            <div class="filters" role="group" aria-label="Filtrar por tema">
              <button class="chip" type="button" data-filter="todo" aria-pressed="true">Todos</button>
              {filtros.map((f) => <button class="chip" type="button" data-filter={f.id} aria-pressed="false">{f.label}</button>)}
            </div>
          )}
        </div>
        <ul class="plist" data-filter-list>
          {
            articulos.map((a) => (
              <li data-cat={a.data.category}><a href={urlArticulo(a)}><span class="m">{nombreCategoria(a.data.category)}</span><span class="t">{a.data.title}</span><span class="m">{minutosLectura(a)} min</span><span class="ar" aria-hidden="true">→</span><span class="d">{a.data.description}</span></a></li>
            ))
          }
        </ul>
      </section>
    )
  }

  <section class="sub grid" aria-labelledby="b-sub">
    <div class="t rv"><h2 id="b-sub">¿Tienes una fecha cerca?</h2><p class="lead">Te ayudamos a elegir y a llegar a tiempo.</p></div>
    <div class="acts rv2">
      <a class="btn" href="/contacto.html">Solicitar cotización</a>
      <WhatsAppButton ghost label="Conversar por WhatsApp" />
    </div>
  </section>
</Base>

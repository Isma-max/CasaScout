---
import '@fontsource/bricolage-grotesque/latin-400.css';
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-600.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import bricolage400 from '@fontsource/bricolage-grotesque/files/bricolage-grotesque-latin-400-normal.woff2?url';
import dmSans400 from '@fontsource/dm-sans/files/dm-sans-latin-400-normal.woff2?url';
import dmSans600 from '@fontsource/dm-sans/files/dm-sans-latin-600-normal.woff2?url';
import { staging } from '../config/env';
import { site, marca } from '../config/site';

interface Props {
  title: string;
  description: string;
  /** Clase de la página (pg-inicio, pg-somos, ...), usada por la hoja de estilos. */
  pageClass: string;
  current?: 'somos' | 'que-hacemos' | 'clientes-y-proyectos' | 'blog' | 'contacto';
  /** Imagen para compartir (ruta en public/). Por defecto, la imagen de la marca. */
  image?: string;
  /** Texto alternativo de la imagen para compartir. */
  imageAlt?: string;
  /** Tipo Open Graph: "website" (por defecto) o "article". */
  ogType?: 'website' | 'article';
  /** Fecha de publicación (solo artículos). */
  publishedTime?: Date;
  /** Incluye los datos estructurados de Organization (se usa en el inicio). */
  organization?: boolean;
}

const {
  title,
  description,
  pageClass,
  current,
  image = marca.imagen,
  imageAlt = marca.imagenAlt,
  ogType = 'website',
  publishedTime,
  organization = false,
} = Astro.props;

// URLs absolutas: canónica sin "index.html" y recursos con el dominio del sitio.
const origin = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname.replace(/index\.html$/, ''), origin).href;
const imageUrl = new URL(image, origin).href;

// Datos estructurados de Organization, solo con los datos que existen en site.ts.
const telefono = site.whatsapp ? `+${site.whatsapp.replace(/\D/g, '')}` : '';
const sameAs = [site.instagram, site.linkedin].filter(Boolean);
const orgData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: marca.nombre,
  url: new URL('/', origin).href,
  logo: new URL(marca.logo, origin).href,
  description: marca.descripcion,
  ...(site.email && { email: site.email }),
  ...(telefono && { telephone: telefono }),
  ...(site.ciudad && { address: { '@type': 'PostalAddress', addressLocality: site.ciudad } }),
  ...(sameAs.length && { sameAs }),
  ...((telefono || site.email) && {
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'ventas',
      availableLanguage: 'es',
      ...(telefono && { telephone: telefono }),
      ...(site.email && { email: site.email }),
    },
  }),
};
// Evita cerrar el <script> por error si algún dato contuviera "<".
const orgJson = JSON.stringify(orgData).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preload" href={bricolage400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={dmSans400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={dmSans600} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {staging && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={ogType} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content={marca.nombre} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {organization && <script type="application/ld+json" set:html={orgJson} />}
    <Analytics />
  </head>
  <body>
    <div class={`cv ${pageClass}`}>
      <a class="skip" href="#contenido">Saltar al contenido</a>
      <Header current={current} />
      <main id="contenido" tabindex="-1">
        <slot />
      </main>
      <Footer />
    </div>
    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>

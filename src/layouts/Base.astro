---
import '@fontsource/bricolage-grotesque/latin-400.css';
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-600.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Clase de la página (pg-inicio, pg-somos, ...), usada por la hoja de estilos. */
  pageClass: string;
  current?: 'somos' | 'que-hacemos' | 'clientes-y-proyectos' | 'blog' | 'contacto';
}

const { title, description, pageClass, current } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <div class={`cv ${pageClass}`}>
      <Header current={current} />
      <slot />
      <Footer />
    </div>
    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>

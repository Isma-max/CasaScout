# Copia este archivo a .env para desarrollo local y define las mismas variables en Vercel
# (Settings > Environment Variables; Production y Preview). Todas se leen en el build:
# al cambiarlas hay que volver a desplegar.

# Formulario de cotización (https://web3forms.com). Sin clave, el formulario no se muestra.
PUBLIC_WEB3FORMS_KEY=

# URL pública del sitio, sin barra final (canónicas, Open Graph, sitemap, robots.txt).
# Ej.: https://www.casascout.cl. Sin valor se usa la URL de Vercel.
PUBLIC_SITE_URL=

# Mientras sea "true": todas las páginas llevan noindex, el sitemap no se anuncia en robots.txt
# y la analítica no se carga. Poner "false" (o dejarlo vacío) al publicar.
PUBLIC_STAGING=true

# Analítica opcional: "plausible" o "ga4". Vacío: sin analítica.
PUBLIC_ANALYTICS=
# Plausible: dominio registrado en Plausible (y, si usas su versión autoalojada, la URL del script).
PUBLIC_PLAUSIBLE_DOMAIN=
PUBLIC_PLAUSIBLE_SRC=
# GA4: ID de medición, por ejemplo G-XXXXXXXXXX.
PUBLIC_GA4_ID=
